{
  "expo": {
    "name": "banter",
    "slug": "banter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/banter-icon.png",
    "scheme": "banter",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF8F4",
        "foregroundImage": "./assets/images/banter-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/banter-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F4",
          "image": "./assets/images/banter-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "99d0626f-e99b-4474-99d1-b788d0a5290d"
      }
    },
    "owner": "sagalms-team"
  }
}
